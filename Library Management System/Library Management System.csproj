<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Library_Management_System</RootNamespace>
    <AssemblyName>Library Management System</AssemblyName>
    <ApplicationIcon>Logo.ico</ApplicationIcon>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppConfig>App.config</AppConfig>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>

  <!-- Files intentionally excluded (dead/obsolete code not part of the build) -->
  <ItemGroup>
    <Compile Remove="UserControl1.cs" />
    <Compile Remove="UserControl1.Designer.cs" />
    <Compile Remove="Usercontrol\Obsolete\**\*.cs" />
    <EmbeddedResource Remove="UserControl1.resx" />
    <EmbeddedResource Remove="Usercontrol\Obsolete\**\*.resx" />
    <EmbeddedResource Remove="UI\StudentsDashboard.resx" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MySql.Data" Version="9.1.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
    <PackageReference Include="System.Data.SqlClient" Version="4.8.6" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Static\Icons\Logo.png" />
    <EmbeddedResource Include="Static\Icons\user.png" />
    <EmbeddedResource Include="Static\Icons\close_icon-icons.com_50420.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Logo.ico" />
  </ItemGroup>

</Project>